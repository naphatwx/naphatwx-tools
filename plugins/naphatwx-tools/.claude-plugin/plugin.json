{
    "name": "naphatwx-tools",
    "version": "1.9.295",
    "description": "My personal commands shared across PCs",
    "commands": [],
    "skills": [
        "./skills/commit-staged-changes",
        "./skills/list-plugins",
        "./skills/review-code",
        "./skills/update-merge-request",
        "./skills/generate-changelog",
        "./skills/check-job",
        "./skills/write-user-guide",
        "./skills/generate-html-slides",
        "./skills/generate-html-docs",
        "./skills/summarize-weekly-work",
        "./skills/generate-use-case",
        "./skills/get-mr-diffs",
        "./skills/design-feature",
        "./skills/generate-diagram",
        "./skills/generate-mock-ui",
        "./skills/play-scenarios",
        "./skills/smoke-test",
        "./skills/e2e-test",
        "./skills/deployment-plan",
        "./skills/ship-task",
        "./skills/copy-reports"
    ],
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" session",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/herdr-tab-name.sh\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" prompt",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/herdr-tab-name.sh\"",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
