{
    "name": "naphatwx-tools",
    "version": "1.9.53",
    "description": "My personal commands shared across PCs",
    "commands": [],
    "skills": [
        "./skills/commit",
        "./skills/run-parallel",
        "./skills/list-plugins",
        "./skills/review-code",
        "./skills/update-merge-request",
        "./skills/generate-changelog",
        "./skills/check-job",
        "./skills/issue-log",
        "./skills/user-guide",
        "./skills/html-presentation",
        "./skills/html-document",
        "./skills/multi-column-sort",
        "./skills/weekly-work-log",
        "./skills/generate-test-scenario",
        "./skills/plan-feature",
        "./skills/generate-mock-ui"
    ],
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" session",
                        "timeout": 10
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" prompt",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
