{
    "name": "naphatwx-tools",
    "version": "1.9.45",
    "description": "My personal commands shared across PCs",
    "commands": [
        "./commands/commit.md",
        "./commands/run-parallel.md",
        "./commands/list-plugins.md",
        "./commands/review-code.md",
        "./commands/update-merge-request.md",
        "./commands/generate-changelog.md",
        "./commands/check-job.md"
    ],
    "skills": [
        "./skills/issue-log",
        "./skills/user-guide",
        "./skills/html-presentation",
        "./skills/html-document",
        "./skills/multi-column-sort",
        "./skills/weekly-work-log",
        "./skills/generate-test-scenario"
    ],
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" session",
                        "timeout": 10
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/response-rules.sh\" prompt",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
