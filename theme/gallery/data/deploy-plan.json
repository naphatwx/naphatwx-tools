{
  "id": "gallery-example-production",
  "title": "Release !123 · add thing owner",
  "env": "production",
  "source": "https://gitlab.example.com/my-group/my-project/-/merge_requests/123",
  "createdAt": "2026-10-08T03:00:00Z",
  "services": [
    "api",
    "worker",
    "web"
  ],
  "order": "api, then worker, then web",
  "notes": [
    "Migration 0042 is not reversible. Take a snapshot first.",
    "web needs the new owner field from api, so it goes last.",
    "develop also brings 3 other MRs, incl. migration 0041."
  ],
  "phases": [
    {
      "key": "pre",
      "title": "Pre-deploy",
      "steps": [
        {
          "text": "Merge into develop and check its pipeline is green"
        },
        {
          "text": "Cut version v1.86.0",
          "cmd": "git tag v1.86.0 && git push origin v1.86.0"
        },
        {
          "text": "Take a snapshot of the main database",
          "detail": "Migration 0042 drops a column. The snapshot is the only way back.",
          "cmd": "aws rds create-db-snapshot --db-instance-identifier main-production --db-snapshot-identifier pre-0042",
          "tag": "db",
          "risk": "high",
          "check": false
        },
        {
          "text": "Set THING_CACHE_TTL on api",
          "detail": "New key read in apps/api/config.go. Default is 300.",
          "tag": "env",
          "source": "apps/api/config.go",
          "check": false
        },
        {
          "text": "Turn off the thing-owner flag",
          "detail": "The screen stays hidden until the backend is live.",
          "tag": "flag",
          "check": false
        },
        {
          "text": "Confirm the GitLab token can read merge requests",
          "tag": "check",
          "check": true
        }
      ]
    },
    {
      "key": "deploy",
      "title": "Deploy",
      "steps": [
        {
          "text": "Deploy v1.86.0 of api to production"
        },
        {
          "text": "Deploy v1.86.0 of worker to production"
        },
        {
          "text": "Deploy v1.86.0 of web to production"
        }
      ]
    },
    {
      "key": "post",
      "title": "Post-deploy",
      "steps": [
        {
          "text": "Run migration 0042",
          "cmd": "make migrate ENV=production",
          "tag": "db",
          "risk": "high",
          "source": "migrations/0042_thing_owner.sql",
          "check": false
        },
        {
          "text": "Turn on the thing-owner flag",
          "tag": "flag",
          "check": false
        },
        {
          "text": "Smoke test the thing-create flow",
          "cmd": "node smoke/run.mjs production thing-create",
          "tag": "check",
          "check": false
        },
        {
          "text": "Post the release note in #releases",
          "tag": "comms",
          "check": false
        }
      ]
    },
    {
      "key": "rollback",
      "title": "Rollback",
      "steps": [
        {
          "text": "Turn off the thing-owner flag",
          "tag": "flag",
          "check": false
        },
        {
          "text": "Restore the main database snapshot pre-0042",
          "detail": "Only if the migration broke reads.",
          "tag": "db",
          "risk": "high",
          "check": false
        },
        {
          "text": "Redeploy v1.85.3 to production"
        }
      ]
    }
  ]
}
