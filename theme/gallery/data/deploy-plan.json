{
  "id": "gallery-example-staging",
  "title": "Release !123 · add deploy status",
  "env": "staging",
  "source": "https://gitlab.example.com/group/repo/-/merge_requests/123",
  "createdAt": "2026-10-08T10:00:00+07:00",
  "services": ["thanos-grpc", "thanos-worker", "thanos-web"],
  "order": "thanos-grpc, then thanos-worker, then thanos-web",
  "notes": [
    "Migration 0042 is not reversible. Take a snapshot first.",
    "thanos-web needs the new RPC, so it goes last."
  ],
  "phases": [
    {
      "key": "pre",
      "title": "Pre-deploy",
      "steps": [
        { "text": "Take a snapshot of the infra database", "detail": "Migration 0042 drops a column. The snapshot is the only way back.", "cmd": "aws rds create-db-snapshot --db-instance-identifier infra-staging --db-snapshot-identifier pre-0042", "tag": "db", "risk": "high", "check": false },
        { "text": "Set DEPLOY_STATUS_TTL on thanos-grpc", "detail": "New key read in apps/thanos-grpc/config.go. Default is 300.", "cmd": "thanos env set thanos-grpc staging DEPLOY_STATUS_TTL 300", "tag": "env", "source": "apps/thanos-grpc/config.go", "check": false },
        { "text": "Turn off the deploy-status flag", "detail": "The screen stays hidden until the backend is live.", "tag": "flag", "check": false },
        { "text": "Confirm the GitLab token can read merge requests", "tag": "check", "check": true }
      ]
    },
    {
      "key": "post",
      "title": "Post-deploy",
      "steps": [
        { "text": "Run migration 0042", "cmd": "make migrate ENV=staging", "tag": "db", "risk": "high", "source": "migrations/0042_deploy_status.sql", "check": false },
        { "text": "Turn on the deploy-status flag", "tag": "flag", "check": false },
        { "text": "Smoke test the deploy flow", "cmd": "node smoke/run.mjs staging deploy-status", "tag": "check", "check": false },
        { "text": "Post the release note in #thanos-release", "tag": "comms", "check": false }
      ]
    },
    {
      "key": "rollback",
      "title": "Rollback",
      "steps": [
        { "text": "Turn off the deploy-status flag", "tag": "flag", "check": false },
        { "text": "Restore the infra snapshot pre-0042", "detail": "Only if the migration broke reads.", "tag": "db", "risk": "high", "check": false }
      ]
    }
  ]
}
